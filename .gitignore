iread-plugin-*.exe
iread-*-setup.exe
*.apk
*.aab
*.idsig
*.keystore
*.jks
!**/debug.keystore.template
android/build/
iread-android/build/
SHA256SUMS.txt
校验和.txt

# ───────────── 本机工具链（便携 SDK / dotnet / nuget 缓存） ─────────────
.tools/
.dotnet-home/
android-sdk/
android-ndk/
nuget/
packages/
*.nupkg
.gradle/
local.properties

# ───────────── Node / Electron 遗留 ─────────────
node_modules/
dist/
release/
npm-debug.log*

# ───────────── 插件实现（不入库） ─────────────
# 仓库只含插件运行时；本地调试时放这里的插件源码不要提交
src/Iread.Renderer/plugins/
dist/publish/wwwroot/plugins/
yarn-error.log*
.pnpm-store/

# ───────────── 运行时数据与调试残留 ─────────────
# 应用数据根（存储 / 封面缓存 / 插件 / mpv）不进仓库
tempuukan-profile/
Tempuukan-profile/
.test-output/
shots-raw/
*.log
run.log
app-run.log
*.trace
*.cdp.json
expr-*.js
eval-cdp.js

# 备份与快照（本地回滚用，体积大且是二进制）
backup-*/
backup_*/
pack-snap-*/
*-snap/

